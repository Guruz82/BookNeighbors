# Blazor WebAssembly: pubblicazione statica servita da Nginx
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY BookNeighbors.Client/BookNeighbors.Client.csproj BookNeighbors.Client/
COPY BookNeighbors.Common/BookNeighbors.Common.csproj BookNeighbors.Common/
RUN dotnet restore BookNeighbors.Client/BookNeighbors.Client.csproj
COPY . .
RUN dotnet publish BookNeighbors.Client/BookNeighbors.Client.csproj -c Release -o /app/publish --no-restore

FROM nginx:1.28-alpine
RUN apk add --no-cache openssl
COPY --from=build /app/publish/wwwroot/ /usr/share/nginx/html/
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/proxy-headers.conf /etc/nginx/proxy-headers.conf
COPY docker/scripts/40-prepare-local-https.sh /docker-entrypoint.d/40-prepare-local-https.sh
RUN chmod +x /docker-entrypoint.d/40-prepare-local-https.sh
EXPOSE 443

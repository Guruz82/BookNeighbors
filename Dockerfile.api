# Build dalla radice della soluzione BookNeighbors
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY BookNeighbors.API/BookNeighbors.API.csproj BookNeighbors.API/
COPY BookNeighbors.Common/BookNeighbors.Common.csproj BookNeighbors.Common/
RUN dotnet restore BookNeighbors.API/BookNeighbors.API.csproj
COPY . .
RUN dotnet publish BookNeighbors.API/BookNeighbors.API.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "BookNeighbors.API.dll"]

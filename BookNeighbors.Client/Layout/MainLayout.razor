
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using BookNeighbors.Client.Components

@* Layout principale della pagina *@
<div class="page">
    @*sidebar*@
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
      
        <div class="top-row px-4">
            @* Barra di navigazione superiore *@
            <AuthorizeView>
                
                <Authorized Context="authState">
                    <span class="me-3">
                        @authState.User.Identity?.Name
                    </span>
                   <NotificationBell />
                

                    <a href="/logout">
                        Esci
                    </a>
                    
                </Authorized>

                <NotAuthorized>
                    <a href="/login" class="me-3">
                        Accedi
                    </a>

                    <a href="/register">
                        Registrati
                    </a>
                </NotAuthorized>
            </AuthorizeView>

        </div>

        <article class="content px-4">
            @* Contenuto principale della pagina *@
            @Body
        </article>
    </main>
</div>


@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">

            <AuthorizeView>
                <Authorized Context="authState">
                    <span class="me-3">
                        @authState.User.Identity?.Name
                    </span>

                    <a href="/profile" class="me-3">
                        Profilo
                    </a>

                    <a href="/logout">
                        Esci
                    </a>
                </Authorized>

                <NotAuthorized>
                    <a href="/login" class="me-3">
                        Accedi
                    </a>

                    <a href="/register">
                        Registrati
                    </a>
                </NotAuthorized>
            </AuthorizeView>

        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

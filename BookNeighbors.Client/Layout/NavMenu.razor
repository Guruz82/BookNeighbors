
@using Microsoft.AspNetCore.Components.Authorization

@* Menu di navigazione *@

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            Book Neighbors
        </a>
        @* hamburger menu *@
        <button title="Apri menu"
                class="navbar-toggler"
                aria-controls="main-navigation"
                aria-label="Apri o chiudi il menu"
                aria-expanded="@(!collapseNavMenu)"
                @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@*contenitore del menu*@
<div  id="main-navigation" class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">

    <nav class="nav flex-column">
         @* link fisso a Home *@
        <div class="nav-item px-3">
            <NavLink class="nav-link"  href="/"  Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>Home</NavLink>
        </div>
        
        <AuthorizeView>
            <Authorized>
                  @* Link visilbili solo per utenti autenticati *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/miei-libri">
                        I miei libri
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/miei-libri?nuovo=true">
                        Nuovo libro
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/mia-libreria">
                        La mia libreria
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/prestiti">
                        Prestiti
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/profile">
                        Il mio profilo
                    </NavLink>
                </div>
         
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Authorized>
                @* Link visibile solo per utenti con ruolo Admin *@
                 <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="/admin/dashboard">
                        Pannello di controllo
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass =>
        collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

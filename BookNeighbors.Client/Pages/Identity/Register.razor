
@page "/register"
@using BookNeighbors.Client.Interfaces
@using BookNeighbors.Client.Models.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using BookNeighbors.DTO.Account

@inject IAccountManagement Acct

<PageTitle>Registrazione - Book Neighbors</PageTitle>

<h1>Registrazione</h1>

<AuthorizeView>
    <Authorized Context="authState">
        <div class="alert alert-success">
            Sei già autenticato come @authState.User.Identity?.Name.
        </div>
    </Authorized>

    <NotAuthorized>
        @if (formResult.Succeeded)
        {
            <div class="alert alert-success">
                Registrazione completata.
                Ora puoi <a href="/login">accedere</a>.
            </div>
        }
        else
        {
            @foreach (var error in formResult.ErrorList)
            {
                <div class="alert alert-danger">@error</div>
            }

            <EditForm Model="@Input" OnValidSubmit="RegisterUserAsync" FormName="register" Context="editFormContext">

                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="email">Email</label>
                    <InputText id="email"
                               class="form-control"
                               type="email"
                               autocomplete="email"
                               @bind-Value="Input.Email" />
                    <ValidationMessage For="() => Input.Email" />
                </div>

                <div class="mb-3">
                    <label for="displayName">Nome visualizzato</label>
                    <InputText id="displayName"
                               class="form-control"
                               @bind-Value="Input.DisplayName" />
                    <ValidationMessage For="() => Input.DisplayName" />
                </div>

                <div class="mb-3">
                    <label for="firstName">Nome</label>
                    <InputText id="firstName"
                               class="form-control"
                               @bind-Value="Input.FirstName" />
                    <ValidationMessage For="() => Input.FirstName" />
                </div>

                <div class="mb-3">
                    <label for="lastName">Cognome</label>
                    <InputText id="lastName"
                               class="form-control"
                               @bind-Value="Input.LastName" />
                    <ValidationMessage For="() => Input.LastName" />
                </div>

                <div class="mb-3">
                    <label for="password">Password</label>
                    <InputText id="password"
                               type="password"
                               autocomplete="new-password"
                               class="form-control"
                               @bind-Value="Input.Password" />
                    <ValidationMessage For="() => Input.Password" />
                </div>

                <div class="mb-3">
                    <label for="confirmPassword">Conferma password</label>
                    <input id="confirmPassword"
                           type="password"
                           autocomplete="new-password"
                           class="form-control"
                           required
                           @bind="ConfirmPassword" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox id="privacy"
                                   class="form-check-input"
                                   @bind-Value="Input.PrivacyNoticeAcknowledged" />

                    <label for="privacy" class="form-check-label">
                        Dichiaro di aver preso visione
                        dell'<a href="/privacy" target="_blank"
                                rel="noopener noreferrer">informativa privacy</a>.
                    </label>
                <ValidationMessage For="() => Input.PrivacyNoticeAcknowledged" />
                </div>

                <button type="submit"
                        class="btn btn-primary w-100"
                        disabled="@isSubmitting">
                    @(isSubmitting ? "Registrazione..." : "Registrati")
                </button>
            </EditForm>
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    private RegisterRequest Input = new();
    private FormResult formResult = new();

    private string ConfirmPassword = string.Empty;
    private bool isSubmitting;

    private async Task RegisterUserAsync()
    {
        if (Input.Password != ConfirmPassword)
        {
            formResult = new FormResult
            {
                Succeeded = false,
                ErrorList = ["Le password non coincidono."]
            };

            return;
        }

        if (isSubmitting)
            return;

        isSubmitting = true;
        formResult = new FormResult();

        try
        {
            formResult = await Acct.RegisterAsync(Input);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

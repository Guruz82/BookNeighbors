
@page "/login"
@using System.ComponentModel.DataAnnotations
@using BookNeighbors.Client.Interfaces
@using BookNeighbors.Client.Models.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject IAccountManagement Acct
@inject NavigationManager Navigation

<PageTitle>Accedi - Book Neighbors</PageTitle>

<h1>Accedi</h1>

<AuthorizeView>
    <Authorized Context="authState">
        <div class="alert alert-success">
            Sei già autenticato come @authState.User.Identity?.Name.
        </div>
        <a href="/">Torna alla Home</a>
    </Authorized>

    <NotAuthorized>
        @foreach (var error in formResult.ErrorList)
        {
            <div class="alert alert-danger">@error</div>
        }

        <EditForm Model="@Input"
                  OnValidSubmit="LoginUserAsync"
                  FormName="login"
                  Context="loginFormContext">

            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="email">Email</label>
                <InputText id="email"
                           type="email"
                           class="form-control"
                           autocomplete="username"
                           @bind-Value="Input.Email" />
                <ValidationMessage For="() => Input.Email" />
            </div>

            <div class="mb-3">
                <label for="password">Password</label>
                <InputText id="password"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           @bind-Value="Input.Password" />
                <ValidationMessage For="() => Input.Password" />
            </div>

            <button type="submit"
                    class="btn btn-primary w-100"
                    disabled="@isSubmitting">
                @(isSubmitting ? "Accesso..." : "Accedi")
            </button>

            <div class="mt-3">
                Non hai un account?
                <a href="/register">Registrati</a>
            </div>
        </EditForm>
    </NotAuthorized>
</AuthorizeView>

@code {
    private LoginModel Input = new();
    private FormResult formResult = new();
    private bool isSubmitting;

    private async Task LoginUserAsync()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        formResult = new FormResult();

        try
        {
            formResult = await Acct.LoginAsync(
                Input.Email,
                Input.Password);

            if (formResult.Succeeded)
                Navigation.NavigateTo("/");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class LoginModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}

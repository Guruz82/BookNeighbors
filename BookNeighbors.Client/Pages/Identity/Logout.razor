
@page "/logout"
@using BookNeighbors.Client.Interfaces

@inject IAccountManagement Acct
@inject NavigationManager Navigation

<PageTitle>Logout - Book Neighbors</PageTitle>

<h1>Disconnessione</h1>

@if (error)
{
    <div class="alert alert-danger"  role="alert">
        Impossibile effettuare il logout.
    </div>
}
else
{
    <p>Disconnessione in corso...</p>
}

@code {
    private bool error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Acct.CheckAuthenticatedAsync())
                await Acct.LogoutAsync();

            Navigation.NavigateTo("/login");
        }
        catch
        {
            error = true;
        }
    }
}

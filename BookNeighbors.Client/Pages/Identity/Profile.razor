@* Mostra il profilo dell'utente *@
@page "/profile"
@using BookNeighbors.Client.Interfaces
@using BookNeighbors.DTO.Account

@inject IAccountManagement Acct

<PageTitle>Il mio profilo - Book Neighbors</PageTitle>

<h1>Il mio profilo</h1>
@* Mostra le informazioni del profilo dell'utente *@
@if (isLoading)
{
    @* Mostra un messaggio di caricamento *@
    <p>Caricamento profilo...</p>
}
else if (unauthorized)
{
    @* Mostra un messaggio di autorizzazione non concessa *@
    <div class="alert alert-warning">
        Devi effettuare il <a href="/login">login</a>
        per visualizzare il profilo.
    </div>
}
else if (!profileLoaded)
{
    @* Mostra un messaggio di errore nel caricamento del profilo *@
    <div class="alert alert-danger"  role="alert">
        Impossibile caricare il profilo.
    </div>
}
else
{
    @* Mostra le informazioni del profilo dell'utente *@
    <p>
        <strong>Email:</strong> @email
    </p>

    @if (saved)
    {
        @* Mostra un messaggio di successo dopo il salvataggio del profilo *@
        <div class="alert alert-success"  role="status">
            Profilo aggiornato correttamente.
        </div>
    }
    @* Mostra i messaggi di errore *@
    @foreach (var error in errors)
    {
        <div class="alert alert-danger"  role="alert">
            @error
        </div>
    }
    @* Mostra il form per la modifica del profilo *@
    <EditForm Model="@Input" OnValidSubmit="SaveProfileAsync" Context="profileFormContext">

        <DataAnnotationsValidator />
        @* Campo Nickname *@
        <div class="mb-3">
            <label for="displayName" class="form-label">
                Nickname
            </label>
            <InputText id="displayName"
                       class="form-control"
                       @bind-Value="Input.DisplayName" />
            <ValidationMessage For="() => Input.DisplayName" />
        </div>

        @* Campo Biografia *@
        <div class="mb-3">
            <label for="bio" class="form-label">
                Biografia
            </label>
            <InputTextArea id="bio"
                           class="form-control"
                           rows="4"
                           @bind-Value="Input.Bio" />
            <ValidationMessage For="() => Input.Bio" />
        </div>
        @* pulsante salvataggio*@
        <button type="submit"
                class="btn btn-primary"
                disabled="@isSaving">
            @(isSaving ? "Salvataggio..." : "Salva modifiche")
        </button>
    </EditForm>
}

@code {
    private AccountProfileRequest Input = new();

    private string email = string.Empty;
    private string[] errors = [];

    private bool isLoading = true;
    private bool isSaving;
    private bool profileLoaded;
    private bool unauthorized;
    private bool saved;
    // Carica il profilo dell'utente
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await Acct.GetProfileAsync();

            if (profile is null)
            {
                unauthorized = true;
                return;
            }

            email = profile.Email;

            Input = new AccountProfileRequest
            {
                DisplayName = profile.DisplayName,
    
                Bio = profile.Bio
            };

            profileLoaded = true;
        }
        catch (Exception)
        {
            errors = ["Impossibile recuperare i dati del profilo."];
        }
        finally
        {
            isLoading = false;
        }
    }
    // Salva le modifiche al profilo dell'utente
    private async Task SaveProfileAsync()
    {
        if (isSaving)
            return;

        isSaving = true;
        saved = false;
        errors = [];

        try
        {
            var result = await Acct.UpdateProfileAsync(Input);

            saved = result.Succeeded;
            errors = result.ErrorList;
        }
        finally
        {
            isSaving = false;
        }
    }
}

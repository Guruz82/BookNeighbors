@page "/prestiti"
@using System.Net
@using BookNeighbors.Client.Interfaces
@using BookNeighbors.Client.Services
@using BookNeighbors.DTO.Loans
@using BookNeighbors.Client.Components

@inject ILoanClientService LoansApi

<PageTitle>Prestiti - Book Neighbors</PageTitle>

<h1>Prestiti</h1>
@* Mostra messaggi di stato e errori *@
@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success" role="status">@message</div>
}
 
@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@* Mostra la lista dei prestiti inviati e ricevuti *@
@if (isLoading)
{
    <p>Caricamento prestiti...</p>
}
else if (unauthorized)
{
    <p>
        Devi effettuare il
        <a href="/login">login</a>
        per gestire i prestiti.
    </p>
}
else
{
    @* Mostra le richieste inviate *@
  
    <details class="loan-section" open>
        <summary class="loan-section-header">
            <span>Richieste inviate</span>
            <span class="badge bg-secondary">@sent.Count</span>
        </summary>

        <div class="loan-section-content">

            @if (sent.Count == 0)
            {
                <p>Non hai ancora richiesto libri in prestito.</p>
            }
            else
            {
                <div class="list-group mb-4">
                    @* Mostra ogni richiesta inviata con lo stato e la possibilità di annullarla *@
            
                    @foreach (var loan in sent)
                    {
                        <div class="list-group-item" @key="loan.Id">
                            <div class="d-flex justify-content-between align-items-center gap-3">
                                <div class="flex-grow-1">
                                    <strong>@loan.BookTitle</strong>

                                    <div>
                                        Stato: @StatusLabel(loan.Status)
                                    </div>

                                    <small class="text-muted">
                                        Richiesto il @loan.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    </small>
                                </div>

                                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                    <NavLink class="btn btn-sm btn-outline-primary" href="@($"/prestiti/{loan.Id}/chat")">
                                        <i class="bi bi-chat-dots me-1"></i>Messaggi
                                    </NavLink>

                                    @if (loan.Status == "Pending")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" disabled="@isProcessing"
                                                @onclick='() => ChangeStatusAsync(loan.Id, "cancel")'>
                                            Annulla
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                </div>
            }
           
            
        </div>
    </details>
    @* Mostra le richieste ricevute *@
    <details class="loan-section" open>
        <summary class="loan-section-header">
            <span>Richieste ricevute</span>
            <span class="badge bg-secondary">@received.Count</span>
        </summary>

        <div class="loan-section-content">
            @if (received.Count == 0)
            {
                <p>Non hai ricevuto richieste di prestito.</p>
            }
            else
            {
                <div class="list-group">
                    @* Mostra ogni richiesta ricevuta con lo stato e la possibilità di accettarla o rifiutarla *@
                    @foreach (var loan in received)
                    {
                        <div class="list-group-item" @key="loan.Id">
                            @* Mostra il titolo del libro per cui è stata fatta la richiesta e da chi e' stato richiesto *@
                            <strong>@loan.BookTitle</strong>
                    
                            <div>
                                Richiesto da: @loan.RequesterDisplayName
                            </div>
                            @* Mostra lo stato della richiesta *@
                            <div>
                                Stato: @StatusLabel(loan.Status)
                            </div>
                            @* Mostra la data di creazione della richiesta nel formato giorno/mese/anno*@
                            <small class="text-muted">
                                @loan.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                            </small>

                    

                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <NavLink class="btn btn-sm btn-outline-primary" href="@($"/prestiti/{loan.Id}/chat")">
                                    <i class="bi bi-chat-dots me-1"></i>Messaggi
                                </NavLink>

                                @if (loan.Status == "Pending")
                                {
                                    <button type="button" class="btn btn-sm btn-success" disabled="@isProcessing"
                                            @onclick='() => ChangeStatusAsync(loan.Id, "accept")'>
                                        Accetta
                                    </button>

                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@isProcessing"
                                            @onclick='() => ChangeStatusAsync(loan.Id, "reject")'>
                                        Rifiuta
                                    </button>
                                }

                                @if (loan.Status == "Accepted")
                                {
                                    <button type="button" class="btn btn-sm btn-primary" disabled="@isProcessing"
                                            @onclick='() => ChangeStatusAsync(loan.Id, "return")'>
                                        Registra restituzione
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </details>
    @* Statistiche personali *@
   
    <details class="loan-section">
        <summary class="loan-section-header" @onclick="() => showLoanStatistics = true">
            <span>Le mie statistiche</span>
            <i class="bi bi-bar-chart"></i>
        </summary>

        <div class="loan-section-content">
            @if (showLoanStatistics)
            {
                <LoanStatistics />
            }
        </div>
    </details>

}
@code {
    private List<LoanResponse> sent = [];
    private List<LoanResponse> received = [];

    private bool isLoading = true;
    private bool isProcessing;
    private bool unauthorized;

    private string? error;
    private string? message;
    private bool showLoanStatistics;
    // Carica le richieste di prestito inviate e ricevute all'inizializzazione della pagina
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadLoansAsync();
        }
        catch (HttpRequestException ex)
            when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            unauthorized = true;
        }
        catch (Exception ex)
        {
            error = $"Errore caricamento prestiti: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
    // Carica le richieste di prestito inviate e ricevute
    private async Task LoadLoansAsync()
    {
        sent = await LoansApi.GetSentAsync();
        received = await LoansApi.GetReceivedAsync();
    }
    // Cambia lo stato di una richiesta di prestito (accetta, rifiuta, annulla, restituisci)
    private async Task ChangeStatusAsync(Guid id, string action)
    {
        if (isProcessing)
            return;

        isProcessing = true;
        error = null;
        message = null;

        try
        {
            await LoansApi.ChangeStatusAsync(id, action);
            await LoadLoansAsync();

            message = "Operazione completata correttamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }
    // Restituisce l'etichetta leggibile per lo stato di una richiesta di prestito
    private static string StatusLabel(string status) =>
        status switch
        {
            "Pending" => "In attesa",
            "Accepted" => "Accettato",
            "Rejected" => "Rifiutato",
            "Cancelled" => "Annullato",
            "Returned" => "Restituito",
            _ => status
        };
}

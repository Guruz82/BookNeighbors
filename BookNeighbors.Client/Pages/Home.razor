
@page "/"
@using BookNeighbors.Client.Components
@using BookNeighbors.Client.Models.Maps
@using BookNeighbors.Client.Services
@using BookNeighbors.Client.Interfaces
@using BookNeighbors.DTO.Search
@using BookNeighbors.DTO.Categories
@using BookNeighbors.DTO.Books
 
@inject BrowserLocationService BrowserLocation
@inject BookClientService BooksApi
@inject ILoanClientService LoansApi
@inject SearchClientService SearchApi

<PageTitle>Cerca libri - Book Neighbors</PageTitle>

<h1>Cerca libri vicino a te</h1>

<p>
    Scegli una posizione sulla mappa e cerca
    i libri disponibili nelle vicinanze.
</p>

<div class="row g-4">

    <div class="col-lg-4">
        <EditForm Model="@search" OnValidSubmit="SearchBooksAsync">

            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="searchText" class="form-label">
                    Titolo, autore o ISBN
                </label>

                <InputText id="searchText" class="form-control"
                           maxlength="100"
                           placeholder="Cerca un libro..."
                           @bind-Value="search.Text" />

                <ValidationMessage For="() => search.Text" />
            </div>

            <div class="mb-3">
                <label for="categoryId" class="form-label">Categoria</label>

                <InputSelect id="categoryId" class="form-select"
                             @bind-Value="search.CategoryId">

                    <option value="">Tutte le categorie</option>

                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </InputSelect>
            </div>

            <div class="mb-3">
                <label for="radiusKm" class="form-label">
                    Raggio di ricerca (km)
                </label>

                <InputNumber id="radiusKm" class="form-control"
                             min="1"
                             max="100"
                             step="1"
                             @bind-Value="search.RadiusKm" />

                <ValidationMessage For="() => search.RadiusKm" />
            </div>

            <button type="submit"
                    class="btn btn-primary w-100"
                    disabled="@isSearching">

                @(isSearching ? "Ricerca..." : "Cerca libri")
            </button>

        </EditForm>

        @if (!string.IsNullOrWhiteSpace(categoryError))
        {
            <p class="text-warning mt-3">
                @categoryError
            </p>
        }
    </div>

    <div class="col-lg-8">
        <button type="button"
        class="btn btn-outline-primary mb-3"
        disabled="@isLocating"
        @onclick="UseBrowserPositionAsync">
                @(isLocating ? "Rilevamento..." : "Usa la mia posizione")
            </button>

            @if (!string.IsNullOrWhiteSpace(locationMessage))
            {
                <p role="status" class="form-text">
                    @locationMessage
                </p>
            }
        @* Componente riutilizzabile per la mappa interattiva *@
        <LocationMap Latitude="search.Latitude"
                     Longitude="search.Longitude"
                     RadiusKm="search.RadiusKm"
                     Markers="markers"
                     OnLocationChanged="SetSearchPosition"
                     Height="450px" />

        <div class="form-text mt-2">
            Seleziona una posizione sulla mappa oppure spostala utilizzando le frecce della tastiera e premi «Usa il centro della mappa». Il cerchio indica il raggio di ricerca selezionato.
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-4"  role="alert">
        @error
    </div>
}

@if (hasSearched)
{
    @if (!string.IsNullOrWhiteSpace(loanMessage))
    {
        <div class="alert alert-success" role="status">@loanMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(loanError))
    {
        <div class="alert alert-danger"  role="alert">@loanError</div>
    }
    <h2 class="mt-4">
        Risultati della ricerca (@results.Count)
    </h2>

    @if (results.Count == 0)
    {
        <div class="alert alert-info">
            Nessun libro trovato.
            Prova ad aumentare il raggio o modificare i filtri.
        </div>
    }
    else
    {
        <div class="row g-3">
            @if (!string.IsNullOrWhiteSpace(detailsError))
            {
                <div class="alert alert-danger" role="alert">
                    @detailsError
                </div>
            }
            @foreach (var book in results)
            {
                
<div class="col-md-6" @key="book.Id">
    <div class="card h-100">
        <div class="card-body d-flex gap-3">
            <BookCover Title="@book.Title" ThumbnailUrl="@book.ThumbnailUrl" ImageUrl="@book.ImageUrl" />

            <div class="flex-grow-1">
                <h2 class="card-title h5">@book.Title</h2>

                <p class="card-text mb-1">
                    <strong>Autore:</strong> @book.Author
                </p>

                <p class="card-text mb-1">
                    <strong>Libreria:</strong> @book.LibraryName
                </p>

                @if (!string.IsNullOrWhiteSpace(book.City))
                {
                    <p class="card-text mb-1">
                        <strong>Città:</strong> @book.City
                    </p>
                }

                <p class="card-text mb-2">
                    <strong>Distanza:</strong> @book.DistanceKm.ToString("0.00") km
                </p>

                <div class="mb-3">
                    @if (book.IsLoaned)
                    {
                        <span class="badge bg-warning text-dark">In prestito</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Disponibile</span>
                    }
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <NavLink class="btn btn-sm btn-outline-secondary" href="@($"/libri/{book.Id}")">
                        Dettaglio
                    </NavLink>

                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(book.IsLoaned || isRequesting)" @onclick="() => RequestLoanAsync(book.Id)">
                        @(book.IsLoaned ? "Non disponibile" : "Richiedi in prestito")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

            }
        </div>
    }
}

@code {
    private BookSearchRequest search = new()
    {
        Latitude = 45.464,
        Longitude = 9.190,
        RadiusKm = 10
    };

 
    private List<BookSearchResponse> results = [];
    private List<CategoryResponse> categories = [];
    private IReadOnlyList<MapMarker> markers = [];

    private bool isSearching;
    private bool hasSearched;
   private bool isRequesting;
    private string? loanMessage;
    private string? loanError;
    private string? error;
    private string? categoryError;
    private bool isLocating;
    private string? locationMessage;
    private BookDetailsResponse? openedBook;
    private Guid? openingBookId;
    private string? detailsError;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await SearchApi.GetCategoriesAsync();
        }
        catch (Exception)
        {
            categoryError =
                "Impossibile caricare le categorie.";
        }
    }

    private void SetSearchPosition(
        (double Latitude, double Longitude) position)
    {
        search.Latitude = Math.Round(position.Latitude, 3);
        search.Longitude = Math.Round(position.Longitude, 3);
    }

    private async Task SearchBooksAsync()
    {
       
        if (isSearching)
            return;
        
        openedBook = null;
        detailsError = null;
        isSearching = true;
        error = null;
        hasSearched = false;

        try
        {
            results = await SearchApi.SearchBooksAsync(search);

            markers = results
                .GroupBy(b => b.LibraryId)
                .Select(group => new MapMarker(
                    group.First().Latitude,
                    group.First().Longitude,
                    group.First().LibraryName,
                    group.Count() == 1
                        ? "1 libro"
                        : $"{group.Count()} libri"
                ))
                .ToList();

            hasSearched = true;
        }
        catch (Exception)
        {
            results = [];
            markers = [];
            error = "Errore durante la ricerca dei libri.";
        }
        finally
        {
            isSearching = false;
        }
    }



    private async Task RequestLoanAsync(Guid bookId)
    {
        if (isRequesting)
            return;

        isRequesting = true;
        loanMessage = null;
        loanError = null;

        try
        {
            await LoansApi.RequestAsync(bookId);

            loanMessage = "Richiesta di prestito inviata correttamente.";
        }
        catch (Exception ex)
        {
            loanError = ex.Message;
        }
        finally
        {
            isRequesting = false;
        }
    }


// Mostra o nasconde i dettagli di un libro.
private async Task ToggleBookDetailsAsync(Guid bookId)
{
    if (openingBookId.HasValue)
        return;

    detailsError = null;

    // Se il libro è già aperto, chiude il dettaglio
    // senza registrare una nuova visualizzazione.
    if (openedBook?.Id == bookId)
    {
        openedBook = null;
        return;
    }

    openingBookId = bookId;
    openedBook = null;

    try
    {
        // La chiamata API registra anche la visualizzazione.
        openedBook = await BooksApi.OpenPublicBookAsync(bookId);
    }
    catch (Exception)
    {
        detailsError = "Impossibile caricare i dettagli del libro.";
    }
    finally
    {
        openingBookId = null;
    }
}


private async Task UseBrowserPositionAsync()
{
    if (isLocating)
        return;

    isLocating = true;
    locationMessage = null;

    try
    {
        var position =
            await BrowserLocation.GetCurrentPositionAsync();

        SetSearchPosition((
            position.Latitude,
            position.Longitude
        ));

        // I risultati precedenti non corrispondono
        // necessariamente alla nuova posizione.
        hasSearched = false;
        markers = [];

        locationMessage = "Posizione rilevata. Puoi avviare la ricerca.";
    }
    catch (Exception)
    {
        locationMessage =
            "Impossibile rilevare la posizione. " +
            "Puoi selezionarla manualmente sulla mappa.";
    }
    finally
    {
        isLocating = false;
    }
}
}


@page "/mia-libreria"
@using System.Net
@using BookNeighbors.DTO.Libraries
@using BookNeighbors.Client.Services
@using BookNeighbors.Client.Components
@inject LibraryClientService LibraryApi

<PageTitle>La mia libreria - Book Neighbors</PageTitle>

<h1>La mia libreria</h1>

@if (isLoading)
{
    <p>Caricamento...</p>
}
else if (unauthorized)
{
    <div class="alert alert-warning">
        Devi effettuare il <a href="/login">login</a>
        per gestire la tua libreria.
    </div>
}
else if (loadFailed)
{
    <div class="alert alert-danger"  role="alert">
        Impossibile caricare la libreria.
    </div>
}
else
{
    <p>
        @(exists
            ? "Modifica i dati della tua libreria."
            : "Crea la tua libreria personale.")
    </p>

    @if (saved)
    {
        <div class="alert alert-success"  role="status">
            Libreria salvata correttamente.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger"  role="alert"> @error</div>
    }
    <!-- Form per la creazione o modifica della libreria -->
    <EditForm Model="@Input"
              OnValidSubmit="SaveLibraryAsync"
              Context="libraryFormContext">

        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="libraryName" class="form-label">Nome libreria</label>
            <InputText id="libraryName" class="form-control"
                       @bind-Value="Input.Name" />
            <ValidationMessage For="() => Input.Name" />
        </div>

        <div class="mb-3">
            <label for="city" class="form-label">Città</label>
            <InputText id="city" class="form-control"
                       @bind-Value="Input.City" />
            <ValidationMessage For="() => Input.City" />
        </div>

        <div class="mb-3">
            <label for="areaName" class="form-label">Zona</label>
            <InputText id="areaName" class="form-control"
                       @bind-Value="Input.AreaName" />
            <ValidationMessage For="() => Input.AreaName" />
        </div>

        <div class="mb-3">
         
          <fieldset class="border rounded p-3">
                                <legend class="fs-6">Posizione della libreria</legend>   
    <!-- Componente riutilizzabile per la mappa interattiva -->
    <LocationMap   Latitude="Input.Latitude"
                 Longitude="Input.Longitude"
                 OnLocationChanged="SetLibraryPosition"
                 Height="380px" />

    <div class="form-text">
         Seleziona una posizione sulla mappa oppure spostala utilizzando le frecce della tastiera e premi «Usa il centro della mappa». Il cerchio indica il raggio di ricerca selezionato.
    </div>

    <ValidationMessage For="() => Input.Latitude" />
    <ValidationMessage For="() => Input.Longitude" />
    </fieldset>
</div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input"
                           id="locationConsent"
                           @bind-Value="Input.LocationConsent" />

            <label class="form-check-label"
                   for="locationConsent">
                Autorizzo l'utilizzo della posizione
                approssimativa per rendere visibile
                la mia libreria.
            </label>
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input"
                           id="isPublished"
                           @bind-Value="Input.IsPublished" />

            <label class="form-check-label"
                   for="isPublished">
                Rendi pubblica la libreria
            </label>
        </div>

        <button type="submit"
                class="btn btn-primary"
                disabled="@isSaving">
            @(isSaving ? "Salvataggio..." : "Salva libreria")
        </button>
    </EditForm>
}

@code {
    private LibraryRequest Input = new();

    private bool isLoading = true;
    private bool loadFailed;
    private bool unauthorized;
    private bool exists;
    private bool isSaving;
    private bool saved;

    private string? error;
    // Carica i dati della libreria dell'utente
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var library = await LibraryApi.GetMineAsync();

            if (library is not null)
            {
                exists = true;

                Input = new LibraryRequest
                {
                    Name = library.Name,
                    City = library.City,
                    AreaName = library.AreaName,
                    Latitude = library.Latitude,
                    Longitude = library.Longitude,
                    LocationConsent = library.LocationConsent,
                    IsPublished = library.IsPublished
                };
            }
        }
        catch (HttpRequestException ex)
            when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            unauthorized = true;
        }
        catch (Exception)
        {
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
        }
    }
    // Salva la libreria
    private async Task SaveLibraryAsync()
    {
        if (isSaving)
            return;

        saved = false;
        error = null;

        if (Input.IsPublished && !Input.LocationConsent)
        {
            error = "Per pubblicare la libreria devi autorizzare "
                  + "l'utilizzo della posizione.";
            return;
        }

        isSaving = true;

        try
        {
            // Salva la libreria tramite il servizio LibraryApi
            await LibraryApi.SaveAsync(Input, exists);

            exists = true;
            saved = true;
        }
        catch (HttpRequestException ex)
            when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            unauthorized = true;
        }
        catch (Exception ex)
        {
            error = $"Impossibile salvare la libreria: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
    // Imposta la posizione della libreria in base alla selezione sulla mappa
    private void SetLibraryPosition(
    (double Latitude, double Longitude) position)
    {
        Input.Latitude = Math.Round(position.Latitude, 3);
        Input.Longitude = Math.Round(position.Longitude, 3);
    }
}
